function THebDate.DHPToParts: Integer;
begin
  result:=((24*Day+Hour)*1080)+Part;
end;

function THebDate.DHPToString: String;
begin
  result:=IntToStr(Day)+','+IntToStr(Hour)+','+IntToStr(Part);
end;

function THebDate.HPToParts: Integer;
begin
  result:=Hour*1080+Part;
end;

function THebDate.Before15589: Boolean;
begin
  {$IFDEF CS2}CodeSite.EnterMethod( 'THebDate.Before16589' );{$ENDIF}
  result:=HPToParts<15*1080+589;
  {$IFDEF CS2}CodeSite.ExitMethod( 'THebDate.Before16589' );{$ENDIF}
end;

function THebDate.Before9204: Boolean;
begin
  {$IFDEF CS2}CodeSite.EnterMethod( 'THebDate.Before9204' );{$ENDIF}
  result:=Hour*1080+Part<9*1080+204;
  {$IFDEF CS2}CodeSite.ExitMethod( 'THebDate.Before9204' );{$ENDIF}
end;


function TYearCode.ToString(YearIsLeapYear: Boolean): String;
begin
  case NewYearOn of
  wdMonday: result:='2';
  wdTuesday: result:='3';
  wdThursday: result:='5';
  wdShabbos: result:='7';
  end;

  case YearCompleteness of
  ycMissing: result:=result+'d';
  ycNormal:  result:=result+'r';
  ycFull:    result:=result+'a';
  end;

  case PassoverOn of
  wdSunday:  result:=result+'1';
  wdTuesday: result:=result+'3';
  wdThursday:result:=result+'5';
  wdShabbos: result:=result+'7';
  end;

  if YearIsLeapYear then
    result:=UpperCase(result);

end;

