  SaveYearCode: String;
begin
  lvGeneral.Clear;
  lvFiltered.Clear;

  SaveYearCode:=edtYearCode.Text;
  HebYear:=THebYear.Create;
  try
    HebYear.HYear:=StrToInt(edtHebYear.Text);
    HebYear.HMonth:=1;
    HebYear.CalcNextYearsNewYearsDay;
    edtYearCode.Text:=HebYear.YearCode.ToString;
