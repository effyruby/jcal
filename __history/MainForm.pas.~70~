procedure TfrmMain.Button7Click(Sender: TObject);
var
  s1: TDate;
 Hours, Days, NoOfYears, Tekufa, Mins: Integer;
 _Hours, StartHour: Integer;
 NewDate, StartDate: TDate;
begin
  Tekufa:=StrToInt(Edit2.Text);
  case Tekufa  of
  0:begin
    Mins:=0;
    Hours:=0;
  end;
  1:begin
    Mins:=30;
    Hours:=7;
  end;
  2:begin
    Mins:=0;
    Hours:=15;
  end;
  3:begin
    Mins:=30;
    Hours:=22;
  end;
  end;

  NoOfYears:=StrToInt(edtHebYear.Text);
  CodeSite.Send( 'NoOfYears', NoOfYears );
  Hours:=NoOfYears*30+Hours;
  CodeSite.Send( 'Hours', Hours );
  _Hours:=Hours mod 24;
  CodeSite.Send( '_Hours', _Hours );
  Days:=Hours div 24;
  CodeSite.Send( 'Days', Days );
  Days:=Days mod 7;
  CodeSite.Send( 'Days', Days );
  CodeSite.Send( 'Mins', Mins );


  S1:=EncodeDate(1905, 1, 6);
  S1:=StrToDate('06/01/1995');
//  DqyOfWeek(StartDate);
  StartHour:=10;
  NewDate:=StartDate+1;
  Hours:=StartHour+6;
  if Hours>24 then
  begin
    Hours:=Hours-24;
    NewDate:=NewDate+1;
  end;

  Mins:=60;
//  StartTime:=StrToTime(10:30);
end;

procedure TfrmMain.Button8Click(Sender: TObject);
var
  k, StartYear: Integer;
  HebYear: THebYear;
begin
  lvGeneral.Clear;
  lvFiltered.Clear;

  StartYear:=StrToInt(edtHebYear.Text);
  HebYear:=THebYear.Create;
  try
    for k:=StartYear to StartYear+seNoOfYears1.Value do
    begin
      HebYear.HYear:=k;
      HebYear.HMonth:=1;
      HebYear.CalcNextYearsNewYearsDay;
      edtYearCode.Text:=HebYear.YearCode.ToString;
      if HebYear.YearISLeapYear then
        Log(k.ToString,edtYearCode.Text,'L/'+HebYear.YearInCycle.ToString)
      else
        Log(k.ToString,edtYearCode.Text, HebYear.YearInCycle.ToString);
      Application.ProcessMessages;
    end;
  finally
    HebYear.Free;
  end;
end;

